# Contact plan: all links up for 24 h. Used by ion/selftest.sh.
#
# ion/start_nodes.sh prepends "@ <UTC start time>" so that every node loads
# an identical plan with the same reference time; "+N" below is N seconds
# after that reference time.
#
# a contact <start> <stop> <from node> <to node> <rate, bytes/s>
# a range   <start> <stop> <node A> <node B> <one-way light time, whole seconds>
#   A range whose first node number is lower than the second also declares
#   the reverse direction (ionrc(5)).
#   ION accepts only whole seconds; the 1.3 s Earth-Moon light time is
#   entered as 2 s (rounded up so LTP retransmission timers, which are
#   computed from the range, do not expire before the emulated round trip).
#   The rover-gateway leg (emulated at 0.25 s) is entered as 1 s.

a contact +0 +86400 99 50 125000
a contact +0 +86400 50 99 125000
a contact +0 +86400 50 23 125000
a contact +0 +86400 23 50 125000

a range +0 +86400 50 99 1
a range +0 +86400 23 50 2
